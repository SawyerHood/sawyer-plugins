{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "host.ts",
    "contract.ts",
    "openrouter.ts",
    "openrouter.test.ts",
    "host.test.ts",
    "test-audio.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "app.tsx",
    "components",
    "lib"
  ]
}
