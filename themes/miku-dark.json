{
  "name": "Miku Night",
  "type": "dark",
  "colors": {
    "editor.background": "#0d141b",
    "editor.foreground": "#d9f0ee",
    "editorLineNumber.foreground": "#4f6870",
    "editorLineNumber.activeForeground": "#39c5bb",
    "editorCursor.foreground": "#ff6fae",
    "editor.selectionBackground": "#39c5bb33",
    "editor.inactiveSelectionBackground": "#39c5bb20",
    "editor.lineHighlightBackground": "#39c5bb0d",
    "editorIndentGuide.background1": "#244047",
    "editorIndentGuide.activeBackground1": "#39c5bb",
    "editorWhitespace.foreground": "#244047"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#668a8d", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#ff79b7" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw.string"],
      "settings": { "foreground": "#a7e86f" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#ffc56f" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#65e1d7" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#83cdf0" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#d9f0ee" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#ff9bca" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#86aaa7" }
    },
    {
      "scope": ["markup.heading", "entity.name.tag"],
      "settings": { "foreground": "#39c5bb", "fontStyle": "bold" }
    }
  ]
}
